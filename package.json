{
  "name": "scapio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Scapio — lokales Dashboard fuer ein Scalable-Capital-Depot",
  "license": "MIT",
  "author": "Jürgen Röhm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jx42/Scapio.git"
  },
  "bugs": {
    "url": "https://github.com/jx42/Scapio/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/start.ts",
    "update": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/update.ts",
    "deinstallieren": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/deinstallieren.ts",
    "dev": "node --experimental-strip-types start/dev.ts",
    "demo": "node --experimental-strip-types start/demo.ts",
    "demo:export": "npm run build && node --experimental-strip-types start/demoExport.ts",
    "edgecases": "node --experimental-strip-types start/edgecases.ts",
    "build": "npm run typecheck && vite build",
    "check": "npm run -s typecheck && npm run -s lint && npm run -s test",
    "check:kurz": "node --experimental-strip-types start/pruefung.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:tz": "node --experimental-strip-types start/zeitzonen.ts",
    "test:invarianten": "vitest run test/invarianten",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:abdeckung": "vitest run --coverage",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ingest": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types ingest/lauf.ts",
    "verify": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/verify.ts",
    "leak-pruefung": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/leakPruefung.ts",
    "verify:zaehlung": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/verify.ts --nur-zaehlung",
    "mcp-login": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/mcpLogin.ts",
    "kontrast": "node --experimental-strip-types start/kontrast.ts",
    "abdruck": "node --experimental-strip-types start/abdruck.ts",
    "vertrag": "node --experimental-strip-types start/vertrag.ts",
    "backup": "node start/nodeVersion.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types start/backup.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.2.1",
    "lucide-react": "^1.35.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.10.2",
    "eslint": "^9.19.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^3.23.2",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^5.0.3"
  }
}
